{
  "name": "toptech-social-studio",
  "private": true,
  "version": "2.0.0",
  "description": "TopTech Social Studio: Free-AI multi-platform social media content studio, campaign planner, CSV bulk manager, and Facebook Page scheduler",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "VITE_DEV_SERVER=true tsx server.ts",
    "build": "vite build && esbuild src/server-app.ts --bundle --platform=node --format=cjs --external:vite --outfile=server.js",
    "start": "node server.ts",
    "start:prod": "node server.js",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": ">=1.0.0",
    "@tailwindcss/vite": ">=4.0.0",
    "@vitejs/plugin-react": ">=4.0.0",
    "dotenv": ">=16.4.0",
    "esbuild": ">=0.20.0",
    "express": ">=4.19.0",
    "express-rate-limit": ">=7.4.0",
    "helmet": ">=8.0.0",
    "lucide-react": ">=0.400.0",
    "motion": ">=11.0.0",
    "multer": ">=1.4.5-lts.1",
    "react": ">=18.3.0",
    "react-dom": ">=18.3.0",
    "tsx": ">=4.0.0",
    "vite": ">=5.0.0"
  },
  "devDependencies": {
    "@types/express": ">=4.17.21",
    "@types/multer": ">=1.4.11",
    "@types/node": ">=20.0.0",
    "@types/react": ">=18.3.0",
    "@types/react-dom": ">=18.3.0",
    "autoprefixer": ">=10.4.0",
    "tailwindcss": ">=4.0.0",
    "typescript": ">=5.0.0"
  }
}
