{
  "name": "toptech-social-studio",
  "private": true,
  "version": "2.0.0",
  "description": "TopTech Social Studio: Free-AI multi-platform social media content studio, campaign planner, CSV bulk manager, and Facebook Page scheduler",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "VITE_DEV_SERVER=true tsx server.ts",
    "build": "node scripts/hostinger-build.cjs",
    "build:force": "FORCE_BUILD=true node scripts/hostinger-build.cjs",
    "start": "node server.ts",
    "start:prod": "node server.js",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^1.0.0 || ^2.0.0",
    "dotenv": "^16.4.7 || ^17.0.0",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1 || ^2.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11 || ^2.0.0",
    "@types/node": "^20.0.0 || ^22.0.0",
    "@types/react": "^18.3.0 || ^19.0.0",
    "@types/react-dom": "^18.3.0 || ^19.0.0",
    "@vitejs/plugin-react": "^4.3.0 || ^6.0.0",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.24.0 || ^0.25.0",
    "lucide-react": ">=0.400.0",
    "motion": "^11.0.0 || ^12.0.0",
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0 || ^7.0.0",
    "vite": "^5.4.0 || ^6.0.0 || ^8.0.0"
  }
}
